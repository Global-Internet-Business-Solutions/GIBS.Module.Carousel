@using Microsoft.AspNetCore.Components.Forms
@using Oqtane.Modules.Controls
@using GIBS.Module.Carousel.Services
@using GIBS.Module.Carousel.Models

@namespace GIBS.Module.Carousel
@inherits ModuleBase
@inject ICarouselService ClientCarouselService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Edit> Localizer
@inject IFileService FileService
@inject ISettingService SettingService

<h4>@(_id == 0 ? Localizer["Add"] : Localizer["Edit"]) @Localizer["Carousel"]</h4>

<form @ref="form" class="@(validated ? "was-validated" : "needs-validation")" novalidate>
    <div class="container">
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="title" HelpText="Enter a title" ResourceKey="Title">Title: </Label>
            <div class="col-sm-9">
                <input id="title" class="form-control" @bind="@_title" required />
            </div>
        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="upload" HelpText="Upload the file you want" ResourceKey="Label.UploadImage">Image: </Label>
            <div class="col-sm-9">
                <FileManager UploadMultiple="false" Filter="jpg,png,gif,jpeg"
                             FolderId="@_folderId"
                             ShowSuccess="true" ShowFolders="false" ShowFiles="true" ShowImage="true"
                             OnUpload="@HandleFileUpload" OnSelectFile="@HandleFileSelect" />
            </div>
        </div>

        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="imageURL" HelpText="Upload or enter an image URL." ResourceKey="Label.ImageURL">@Localizer["Label.ImageURL"]</Label>
            <div class="col-sm-9">
                <input id="imageURL" class="form-control mb-1" @bind="@_imageUrl" placeholder="Paste or enter image URL" />

                @if (!string.IsNullOrEmpty(_imageUrl))
                {
                    <img src="@_imageUrl" alt="Image preview" style="max-width: 280px; max-height: 200px; margin-top: 5px; margin-bottom: 10px;" />
                }
            </div>
        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="description" HelpText="Enter a description" ResourceKey="Description">Description: </Label>
            <div class="col-sm-9">
                <textarea id="description" class="form-control" @bind="@_description"></textarea>
            </div>
        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="isActive" HelpText="Is the carousel active?" ResourceKey="IsActive">Is Active: </Label>
            <div class="col-sm-9">
                <input id="isActive" type="checkbox" class="form-check-input" @bind="@_isActive" />
            </div>
        </div>
    </div>
    <button type="button" class="btn btn-success" @onclick="Save">@Localizer["Save"]</button>
    @if (_id != 0)
    {
        <button type="button" class="btn btn-secondary ms-1" @onclick="Reset">@Localizer["Cancel"]</button>
        <br /><br />
        <AuditInfo CreatedBy="@_createdby" CreatedOn="@_createdon" ModifiedBy="@_modifiedby" ModifiedOn="@_modifiedon"></AuditInfo>
    }
    else
    {
        <NavLink class="btn btn-secondary ms-1" href="@NavigateUrl()">@Localizer["Cancel"]</NavLink>
    }
</form>

<hr />

@if (_Carousels == null)
{
    <p><em>Loading...</em></p>
}
else if (_Carousels.Count != 0)
{
    <Pager Items="@_Carousels">
        <Header>
            <th style="width: 1px;">&nbsp;</th>
            <th style="width: 1px;">&nbsp;</th>
            <th>@Localizer["Title"]</th>
            <th>@Localizer["Description"]</th>
            <th>@Localizer["Image"]</th>
            <th>@Localizer["IsActive"]</th>
        </Header>
        <Row>
            <td>
                <button type="button" class="btn btn-primary" @onclick="@(() => LoadCarousel(context))">@Localizer["Edit"]</button>
            </td>
            <td>
                <ActionDialog Header="Delete Carousel" Message="Are You Sure You Wish To Delete This Carousel?" Action="Delete" Security="SecurityAccessLevel.Edit" Class="btn btn-danger" OnClick="@(async () => await Delete(context))" ResourceKey="Delete" Id="@context.CarouselId.ToString()" />
            </td>
            <td>@context.Title</td>
            <td>@context.Description</td>
            <td><img src="@context.ImageUrl" alt="Image preview" style="max-width: 280px; max-height: 200px;" /></td>
            <td>@context.IsActive</td>
        </Row>
    </Pager>
}
else
{
    <p>@Localizer["Message.DisplayNone"]</p>
}

@code {
    public override SecurityAccessLevel SecurityAccessLevel => SecurityAccessLevel.Edit;

    public override string Actions => "Add,Edit";

    public override string Title => "Manage Carousel";

    public override List<Resource> Resources => new List<Resource>()
    {
        new Stylesheet("_content/GIBS.Module.Carousel/Module.css")
    };

    private ElementReference form;
    private bool validated = false;

    private int _id;
    private string _title;
    private string _imageUrl;
    private string _description;
        private bool _isActive = true;
    private string _createdby;
    private DateTime _createdon;
    private string _modifiedby;
    private DateTime _modifiedon;
    private int _folderId = 1;
    private int _imageMaxWidth; // Set your max width here
    private int _imageMaxHeight; // Set your max height here

    private List<Carousel> _Carousels;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _imageUrl = string.Empty;

            // Correctly parse the setting as an integer
            if (int.TryParse(SettingService.GetSetting(ModuleState.Settings, "ImageFolder", "1"), out int folderId))
            {
                _folderId = folderId;
            }
            else
            {
                // Handle the case where the setting is not a valid integer
                _folderId = 1; // Default value or handle error
            }

            if (!int.TryParse(SettingService.GetSetting(ModuleState.Settings, "ImageMaxWidth", "800"), out _imageMaxWidth))
            {
                _imageMaxWidth = 800;
            }
            if (!int.TryParse(SettingService.GetSetting(ModuleState.Settings, "ImageMaxHeight", "600"), out _imageMaxHeight))
            {
                _imageMaxHeight = 600;
            }


            if (PageState.Action == "Edit")
            {
                _id = Int32.Parse(PageState.QueryString["id"]);
                await LoadCarouselById(_id);
            }
            _Carousels = await ClientCarouselService.GetCarouselsAsync(ModuleState.ModuleId);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Carousel {CarouselId} {Error}", _id, ex.Message);
            AddModuleMessage(Localizer["Message.LoadError"], MessageType.Error);
        }
    }

    private async Task LoadCarouselById(int id)
    {
        Carousel carousel = await ClientCarouselService.GetCarouselAsync(id, ModuleState.ModuleId);
        if (carousel != null)
        {
            _id = carousel.CarouselId;
            _title = carousel.Title;
            _imageUrl = carousel.ImageUrl;
            _description = carousel.Description;
            _isActive = carousel.IsActive;
            _createdby = carousel.CreatedBy;
            _createdon = carousel.CreatedOn;
            _modifiedby = carousel.ModifiedBy;
            _modifiedon = carousel.ModifiedOn;
        }
    }

    private async Task LoadCarousel(Carousel carousel)
    {
        await LoadCarouselById(carousel.CarouselId);
        StateHasChanged();
    }

    private void Reset()
    {
        _id = 0;
        _title = string.Empty;
        _imageUrl = string.Empty;
        _description = string.Empty;
        _isActive = true;
        _createdby = string.Empty;
        _createdon = DateTime.MinValue;
        _modifiedby = string.Empty;
        _modifiedon = DateTime.MinValue;
        validated = false;
    }

    private async Task Delete(Carousel carousel)
    {
        try
        {
            await ClientCarouselService.DeleteCarouselAsync(carousel.CarouselId, ModuleState.ModuleId);
            await logger.LogInformation("Carousel Deleted {Carousel}", carousel);
            if (_id == carousel.CarouselId) Reset();
            _Carousels = await ClientCarouselService.GetCarouselsAsync(ModuleState.ModuleId);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Deleting Carousel {Carousel} {Error}", carousel, ex.Message);
            AddModuleMessage(Localizer["Message.DeleteError"], MessageType.Error);
        }
    }

    private async Task Save()
    {
        try
        {
            validated = true;
            var interop = new Oqtane.UI.Interop(JSRuntime);
            if (await interop.FormValid(form))
            {
                if (_id == 0)
                {
                    Carousel carousel = new Carousel();
                    carousel.ModuleId = ModuleState.ModuleId;
                    carousel.Title = _title;
                    carousel.ImageUrl = _imageUrl;
                    carousel.Description = _description;
                    carousel.IsActive = _isActive;
                    carousel = await ClientCarouselService.AddCarouselAsync(carousel);
                    await logger.LogInformation("Carousel Added {Carousel}", carousel);
                }
                else
                {
                    Carousel carousel = await ClientCarouselService.GetCarouselAsync(_id, ModuleState.ModuleId);
                    carousel.Title = _title;
                    carousel.ImageUrl = _imageUrl;
                    carousel.Description = _description;
                    carousel.IsActive = _isActive;
                    await ClientCarouselService.UpdateCarouselAsync(carousel);
                    await logger.LogInformation("Carousel Updated {Carousel}", carousel);
                }
                Reset();
                _Carousels = await ClientCarouselService.GetCarouselsAsync(ModuleState.ModuleId);
                StateHasChanged();
            }
            else
            {
                AddModuleMessage(Localizer["Message.SaveValidation"], MessageType.Warning);
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Saving Carousel {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.SaveError"], MessageType.Error);
        }
    }

    private async void HandleFileUpload(int fileId)
    {
        if (_imageUrl != null)
        {
            var uploadedFile = await FileService.GetFileAsync(fileId);
            if (uploadedFile != null)
            {
                _imageUrl = uploadedFile.Url;

                // // Check if the image exceeds the maximum dimensions from settings
                // if (uploadedFile.ImageWidth > _imageMaxWidth || uploadedFile.ImageHeight > _imageMaxHeight)
                // {
                //     try
                //     {
                //         var resizedFile = await ClientSEOToolService.ResizeImageAsync(uploadedFile.FileId, _imageMaxWidth, _imageMaxHeight, ModuleState.ModuleId);
                //         if (resizedFile != null)
                //         {
                //             _imageUrl = resizedFile.Url;
                //         }
                //         else
                //         {
                //             // Fallback to original image if resize fails
                //             _imageUrl = uploadedFile.Url;
                //             AddModuleMessage("Image resizing failed. Using original image.", MessageType.Warning);
                //         }
                //     }
                //     catch (Exception ex)
                //     {
                //         AddModuleMessage($"Error resizing image: {ex.Message}", MessageType.Error);
                //         _imageUrl = uploadedFile.Url; // Fallback to original image
                //     }
                // }
                // else
                // {
                //     _imageUrl = uploadedFile.Url;
                // }
            }
            else
            {
                _imageUrl = null;
            }
            StateHasChanged();
        }
    }

    private async void HandleFileSelect(int fileId)
    {
        var selectedFile = await FileService.GetFileAsync(fileId);
        if (selectedFile != null)
        {
            _imageUrl = selectedFile.Url;
            StateHasChanged();
        }
    }
}
