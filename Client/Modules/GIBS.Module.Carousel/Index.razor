@using GIBS.Module.Carousel.Services
@using GIBS.Module.Carousel.Models

@namespace GIBS.Module.Carousel
@inherits ModuleBase
@inject ICarouselService ClientCarouselService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Index> Localizer
@inject ISettingService SettingService



@if (_Carousels == null)
{
    <p><em>You need to upload some pictures...</em></p>
}
else if (_Carousels.Count > 0)
{
    <div id="gibsCarousel" class="carousel slide" data-bs-ride="carousel" data-min-per-slide="@_numberPerSlide">
        <div class="carousel-inner" role="listbox">
            @for (int i = 0; i < _Carousels.Count; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <div class="col-6">
                        <img src="@_Carousels[i].ImageUrl" class="img-fluid" alt="@_Carousels[i].Title" style="height:@(_imageHeight)" loading="eager" decoding="async" />
                    </div>
                </div>
            }
        </div>
        <a class="carousel-control-prev bg-transparent w-aut" href="#gibsCarousel" role="button" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        </a>
        <a class="carousel-control-next bg-transparent w-aut" href="#gibsCarousel" role="button" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
        </a>
    </div>
}
else
{
    <p>@Localizer["Message.DisplayNone"]</p>
}

<div class="text-end">
    <ActionLink Action="Add" Security="SecurityAccessLevel.Edit" Text="Manage Carousel" ResourceKey="ManageCarousel" />
</div>

@code {
    public override string RenderMode => RenderModes.Static;

    public override List<Resource> Resources => new List<Resource>()
    {
        new Stylesheet("_content/GIBS.Module.Carousel/Module.css?v=9"),
        new Script("_content/GIBS.Module.Carousel/Module.js?v=9")
    };

    List<Carousel> _Carousels;
    private string _numberPerSlide;
    private string _imageHeight;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _numberPerSlide = SettingService.GetSetting(ModuleState.Settings, "NumberVisible", "5");
            _imageHeight = SettingService.GetSetting(ModuleState.Settings, "ImageHeight", "300");

            var allCarousels = await ClientCarouselService.GetCarouselsAsync(ModuleState.ModuleId);
            _Carousels = allCarousels.Where(c => c.IsActive).OrderBy(item => item.OrderBy).ToList();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Carousel {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.LoadError"], MessageType.Error);
        }
    }
}